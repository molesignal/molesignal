{
  "logs": [
    {
      "query": "level = 'error'",
      "read": { "filters": [{ "field": "level", "op": "=", "value": "error", "quoted": true }], "freeText": [] }
    },
    {
      "query": "level eq error AND status_code >= 500",
      "read": {
        "filters": [
          { "field": "level", "op": "=", "value": "error", "quoted": false },
          { "field": "status_code", "op": ">=", "value": "500", "quoted": false }
        ],
        "freeText": []
      }
    },
    {
      "query": "service.name ne \"checkout\"",
      "read": { "filters": [{ "field": "service.name", "op": "!=", "value": "checkout", "quoted": true }], "freeText": [] }
    },
    {
      "query": "message like 'timeout'",
      "read": { "filters": [{ "field": "message", "op": "contains", "value": "timeout", "quoted": true }], "freeText": [] }
    },
    {
      "query": "host = ''",
      "read": { "filters": [{ "field": "host", "op": "=", "value": "", "quoted": true }], "freeText": [] }
    },
    {
      "query": "MATCH(message, 'connection reset')",
