    },
    {
      "query": "match_text(message, 'db pool')",
      "read": { "filters": [{ "field": "message", "op": "match_text", "value": "db pool", "quoted": true }], "freeText": [] }
    },
    {
      "query": "timeout",
      "read": { "filters": [], "freeText": ["timeout"] }
    },
    {
