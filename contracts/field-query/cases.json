      "read": {
        "filters": [{ "field": "level", "op": "=", "value": "error", "quoted": true }],
        "freeText": [],
        "where": {
          "or": [
            { "field": "service.name", "op": "=", "value": "checkout", "quoted": true },
            { "text": "timeout" }
          ]
        }
      }
    },
    {
      "query": "a = 1 OR b = 2",
      "read": {
        "filters": [],
        "freeText": [],
        "where": {
          "or": [
            { "field": "a", "op": "=", "value": "1", "quoted": false },
            { "field": "b", "op": "=", "value": "2", "quoted": false }
          ]
        }
      }
    },
    {
      "query": "(a = 1 OR b = 2) AND (c = 3 OR d = 4)",
      "read": {
        "filters": [],
        "freeText": [],
        "where": {
          "and": [
            {
              "or": [
                { "field": "a", "op": "=", "value": "1", "quoted": false },
                { "field": "b", "op": "=", "value": "2", "quoted": false }
              ]
            },
            {
              "or": [
                { "field": "c", "op": "=", "value": "3", "quoted": false },
                { "field": "d", "op": "=", "value": "4", "quoted": false }
              ]
            }
          ]
        }
      }
    },
    {
      "query": "msg = 'it\\'s ok' and level = \"warn\"",
      "read": {
        "filters": [
          { "field": "msg", "op": "=", "value": "it's ok", "quoted": true },
          { "field": "level", "op": "=", "value": "warn", "quoted": true }
        ],
        "freeText": []
      }
    },
    {
      "query": "message contains 'a or b'",
      "read": { "filters": [{ "field": "message", "op": "contains", "value": "a or b", "quoted": true }], "freeText": [] }
    },
    {
      "query": "ORDER = 'x'",
      "read": { "filters": [{ "field": "ORDER", "op": "=", "value": "x", "quoted": true }], "freeText": [] }
    },
