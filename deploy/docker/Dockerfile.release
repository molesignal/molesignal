# CI 已在原生 runner 上完成前端构建并将其嵌入 release 二进制；这里只把同一二进制封装
# 进多架构镜像。
# runtime 用 bullseye-slim（glibc 2.31）：CI 产物地板也是 2.31（rust:1.96-bullseye），
# 低于目标机地板 2.34（Alma 9 / Ubuntu 22.04）。勿用 bookworm/trixie，glibc 会超地板。
ARG TARGETARCH

FROM scratch AS binary-amd64
COPY .release-binaries/amd64/molesignal /molesignal

FROM scratch AS binary-arm64
COPY .release-binaries/arm64/molesignal /molesignal

FROM binary-${TARGETARCH} AS binary

FROM debian:bullseye-slim
RUN printf '%s\n' \
        'deb [check-valid-until=no] http://deb.debian.org/debian bullseye main' \
        'deb [check-valid-until=no] http://deb.debian.org/debian bullseye-updates main' \
        'deb [check-valid-until=no] http://archive.debian.org/debian-security bullseye-security main' \
        > /etc/apt/sources.list \
 && rm -f /etc/apt/sources.list.d/debian.sources \
 && apt-get -o APT::Update::Error-Mode=any update \
 && apt-get install -y --no-install-recommends \
        ca-certificates curl \
        chromium fonts-liberation libnss3 libfreetype6 libharfbuzz0b \
 && rm -rf /var/lib/apt/lists/*
ENV CHROME_PATH=/usr/bin/chromium
WORKDIR /app
COPY --from=binary /molesignal /usr/local/bin/molesignal
RUN chmod 0755 /usr/local/bin/molesignal \
 && mkdir -p /usr/share/molesignal/mmdb
# DB-IP City Lite（CC BY 4.0）不入库：发布流程每次下载一次当月版本，放在 .release-assets/。
COPY .release-assets/dbip-city-lite.mmdb /usr/share/molesignal/mmdb/dbip-city-lite.mmdb
COPY assets/mmdb/NOTICE.txt /usr/share/molesignal/mmdb/NOTICE.txt
COPY conf/config.toml /app/conf/config.toml
# Web UI 已编译进 molesignal；5080 同时提供页面和 HTTP API。
EXPOSE 5080 5082
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://localhost:5080/api/v1/healthz || exit 1
ENTRYPOINT ["molesignal"]
CMD ["--config", "/app/conf/config.toml"]
